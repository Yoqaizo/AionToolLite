<Window x:Class="AionToolLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AionToolLite"
        Icon="AionToolp.ico"
        Width="424" Height="744"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <!-- Connected Sonar Pulse Animation -->
        <Storyboard x:Key="SonarPulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SonarRing1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1.0" To="1.52" Duration="0:0:2.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SonarRing1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1.0" To="1.52" Duration="0:0:2.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SonarRing1" Storyboard.TargetProperty="Opacity" From="0.55" To="0.0" Duration="0:0:2.2"/>

            <DoubleAnimation Storyboard.TargetName="SonarRing2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1.0" To="1.52" BeginTime="0:0:1.1" Duration="0:0:2.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SonarRing2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1.0" To="1.52" BeginTime="0:0:1.1" Duration="0:0:2.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SonarRing2" Storyboard.TargetProperty="Opacity" From="0.45" To="0.0" BeginTime="0:0:1.1" Duration="0:0:2.2"/>
        </Storyboard>

        <!-- Connecting / Disconnecting Spinner Ring Animation -->
        <Storyboard x:Key="SpinnerStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.05"/>
        </Storyboard>
    </Window.Resources>

    <!-- Outer Shadow Padding -->
    <Grid Margin="16">
        <Border x:Name="AppShell"
                CornerRadius="28"
                Background="{DynamicResource ShellBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1.2"
                ClipToBounds="True"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="LaunchScale" ScaleX="0.96" ScaleY="0.96"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.55"/>
            </Border.Effect>

            <Grid>
                <!-- Subtle Ambient Background Glow -->
                <Ellipse x:Name="AmbientGlowTop"
                         Width="340" Height="340"
                         HorizontalAlignment="Center" VerticalAlignment="Top"
                         Margin="0,-110,0,0"
                         IsHitTestVisible="False"
                         Opacity="0.24">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="AmbientGlowColorStop" Color="#B57BFF" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="74"/>
                    </Grid.RowDefinitions>

                    <!-- ==================== TOP HEADER (DRAGGABLE) ==================== -->
                    <Border Grid.Row="0" Background="Transparent" Padding="18,12,14,4" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Brand Logo + Name + Tiny Status Dot -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="AionToolp.png" Width="36" Height="36" Stretch="Uniform" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="AionTool" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Lite" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="2,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,0,0">
                                        <Ellipse x:Name="NetStatusDot" Width="6.5" Height="6.5" Fill="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtHeaderNetState" Text="Checking..." FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Quick Language Pill + Minimize + Close/Tray -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnQuickLang"
                                        Content="FA"
                                        Click="BtnQuickLang_Click"
                                        Style="{StaticResource ChromeIconBtnStyle}"
                                        Width="32" Height="26"
                                        FontSize="10.5"
                                        Margin="0,0,4,0"
                                        ToolTip="Switch English / فارسی"/>
                                <Button Content="—" Click="BtnMinimize_Click" Style="{StaticResource ChromeIconBtnStyle}" ToolTip="Minimize"/>
                                <Button Content="✕" Click="BtnClose_Click" Style="{StaticResource ChromeIconBtnStyle}" Foreground="#F43F5E" ToolTip="Close / Minimize to Tray"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ==================== MAIN VIEWPORT ==================== -->
                    <Grid Grid.Row="1" Margin="18,4,18,6">
                        <Grid x:Name="AnimatedViewHost">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="ViewSlideTransform" X="0" Y="0"/>
                            </Grid.RenderTransform>

                            <!-- ==================== VIEW 1: HOME (HERO ORB) ==================== -->
                            <ScrollViewer x:Name="ViewHome" Visibility="Visible" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                            <Grid MinHeight="556">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Friendly Status Title + Active DNS Pill -->
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,2">
                                    <TextBlock x:Name="TxtHeroState"
                                               Text="Ready to Connect"
                                               FontSize="22" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock x:Name="TxtHeroSubtitle"
                                               Text="Tap the button below for faster, cleaner internet"
                                               FontSize="11.5"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,4,0,0"/>
                                    <Border x:Name="ConnectedDnsPill"
                                            Background="#2210B981"
                                            BorderBrush="#6610B981"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="11,4"
                                            HorizontalAlignment="Center"
                                            Margin="0,8,0,0"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6.5" Height="6.5" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtConnectedDnsBadge"
                                                       Text=""
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#10B981"
                                                       FlowDirection="LeftToRight"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- CENTERPIECE POWER ORB + SONAR RINGS + SPINNER -->
                                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse x:Name="SonarRing1"
                                             Width="152" Height="152"
                                             Stroke="#10B981" StrokeThickness="2"
                                             Opacity="0"
                                             IsHitTestVisible="False"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="SonarScale1" ScaleX="1" ScaleY="1"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>

                                    <Ellipse x:Name="SonarRing2"
                                             Width="152" Height="152"
                                             Stroke="#34D399" StrokeThickness="1.5"
                                             Opacity="0"
                                             IsHitTestVisible="False"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="SonarScale2" ScaleX="1" ScaleY="1"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>

                                    <Ellipse x:Name="SpinnerRing"
                                             Width="172" Height="172"
                                             Stroke="#F59E0B"
                                             StrokeThickness="3"
                                             StrokeDashArray="10 6"
                                             StrokeDashCap="Round"
                                             Opacity="0"
                                             IsHitTestVisible="False"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>

                                    <Button x:Name="BtnPowerOrb"
                                            Click="BtnPowerOrb_Click"
                                            Style="{StaticResource PowerOrbButtonStyle}">
                                        <Button.Effect>
                                            <DropShadowEffect x:Name="OrbGlowShadow" BlurRadius="34" ShadowDepth="0" Color="#B57BFF" Opacity="0.62"/>
                                        </Button.Effect>
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop x:Name="OrbGradStart" Color="#B57BFF" Offset="0"/>
                                                <GradientStop x:Name="OrbGradEnd" Color="#67E8F9" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Width="44" Height="44" Stretch="Uniform"
                                                  Stroke="#FFFFFF" StrokeThickness="2.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M 12,2 L 12,11 M 6.3,5.2 A 9.2,9.2 0 1 0 17.7,5.2"/>
                                            <TextBlock x:Name="TxtOrbAction"
                                                       Text="CONNECT"
                                                       FontSize="10.5" FontWeight="Bold"
                                                       Foreground="#EFFFFFFF"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Selected / Active DNS Quick-Picker Card -->
                                <Button Grid.Row="2" x:Name="BtnHomeOpenDns"
                                        Click="BtnHomeOpenDns_Click"
                                        Style="{StaticResource CardButtonStyle}"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="HomeDnsIconBox" Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
                                            <Path Width="18" Height="18" Stretch="Uniform"
                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.9"
                                                  Data="M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 2,12 L 22,12 M 12,2 C 15,6 15,18 12,22 C 9,18 9,6 12,2"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblHomeServerCaption" Text="SELECTED SERVER" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock x:Name="TxtHomeSelectedDns" Text="Smart Auto" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,1,0,0"/>
                                            <TextBlock x:Name="TxtHomeSelectedIp" Text="Auto-picks the fastest DNS" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Path Grid.Column="2" Width="8" Height="13" Stretch="Uniform"
                                              Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 1,1 L 7,6.5 L 1,12" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <!-- Live Mini Telemetry Strip (Clickable 3-Mode Ping + Traffic) -->
                                <UniformGrid Grid.Row="3" Columns="2" Margin="0,0,0,6">
                                    <Button x:Name="BtnPingCycle"
                                            Click="BtnPingCycle_Click"
                                            Style="{StaticResource CardButtonStyle}"
                                            Margin="0,0,5,0"
                                            Padding="12,10"
                                            ToolTip="Click to switch: Global → Regional → Modem">
                                        <StackPanel x:Name="PingCardContent">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse x:Name="PingQualityDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="LblHomePingTitle" Text="GLOBAL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="92"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Ellipse x:Name="PingDot0" Width="4.5" Height="4.5" Fill="#B57BFF" Margin="0,0,3,0"/>
                                                    <Ellipse x:Name="PingDot1" Width="4.5" Height="4.5" Fill="#475569" Margin="0,0,3,0"/>
                                                    <Ellipse x:Name="PingDot2" Width="4.5" Height="4.5" Fill="#475569"/>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,4,0,0" FlowDirection="LeftToRight">
                                                <TextBlock x:Name="TxtHomePingValue" Text="-- ms" FontSize="17" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock x:Name="TxtHomePingRating" Text="" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Border Style="{StaticResource GlassCardStyle}" Margin="5,0,0,0" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock x:Name="LblHomeTrafficTitle" Text="LIVE TRAFFIC" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                                            <StackPanel Margin="0,4,0,0" FlowDirection="LeftToRight">
                                                <TextBlock x:Name="TxtHomeDlSpeed" Text="⬇ 0 KB/s" FontSize="12.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#10B981"/>
                                                <TextBlock x:Name="TxtHomeUlSpeed" Text="⬆ 0 KB/s" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas" Foreground="#38BDF8"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Grid>
                            </ScrollViewer>

                            <!-- ==================== VIEW 2: DNS PICKER ==================== -->
                            <Grid x:Name="ViewDns" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,6,0,8">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="LblDnsTitle" Text="Choose a Server" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock x:Name="LblDnsSubtitle" Text="Tap to connect · ★ to pin favorite" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>
                                    <Button x:Name="BtnFindFastest"
                                            Content="⚡ Test Speed"
                                            Click="BtnFindFastest_Click"
                                            Style="{StaticResource PillPrimaryBtnStyle}"
                                            Height="34" Padding="12,0" FontSize="11.5"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <ProgressBar x:Name="DnsTestProgress" Grid.Row="1" Height="3" IsIndeterminate="True"
                                             Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0"
                                             Visibility="Collapsed" Margin="0,0,0,8"/>

                                <!-- One-Tap Connect to Fastest Winner Banner -->
                                <Border x:Name="FastestResultBanner"
                                        Grid.Row="2"
                                        Background="#1F10B981"
                                        BorderBrush="#6610B981"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="12,8"
                                        Margin="0,0,0,8"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="TxtFastestWinnerTitle" Text="Fastest Server Found" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                            <TextBlock x:Name="TxtFastestWinnerInfo" Text="Cloudflare · 24 ms" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="BtnConnectFastestWinner"
                                                Content="Connect"
                                                Click="BtnConnectFastestWinner_Click"
                                                Style="{StaticResource PillPrimaryBtnStyle}"
                                                Height="30" Padding="12,0" FontSize="11"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="ChipAll" Content="All" Tag="All" IsChecked="True" Checked="DnsFilterChip_Checked" Style="{StaticResource FilterChipStyle}"/>
                                    <RadioButton x:Name="ChipIran" Content="Iran / Game" Tag="IranGame" Checked="DnsFilterChip_Checked" Style="{StaticResource FilterChipStyle}"/>
                                    <RadioButton x:Name="ChipGlobal" Content="Global" Tag="Global" Checked="DnsFilterChip_Checked" Style="{StaticResource FilterChipStyle}"/>
                                    <RadioButton x:Name="ChipSecurity" Content="Ad &amp; Safe" Tag="Security" Checked="DnsFilterChip_Checked" Style="{StaticResource FilterChipStyle}"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                                    <StackPanel>
                                        <StackPanel x:Name="DnsCardsPanel"/>

                                        <Border Style="{StaticResource GlassCardStyle}" Margin="0,8,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock x:Name="LblCustomDnsHeader" Text="Custom DNS (Save up to 5)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtCustomSlotCount" Text="0 / 5" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBox x:Name="TxtCustomDnsName" Text="" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,7" ToolTip="Custom Server Name (e.g. My Gaming DNS)"/>
                                                <UniformGrid Columns="2" Margin="0,0,0,8" FlowDirection="LeftToRight">
                                                    <TextBox x:Name="TxtCustomDns1" Text="1.1.1.1" Style="{StaticResource ModernInputStyle}" Margin="0,0,4,0" ToolTip="Primary IPv4"/>
                                                    <TextBox x:Name="TxtCustomDns2" Text="1.0.0.1" Style="{StaticResource ModernInputStyle}" Margin="4,0,0,0" ToolTip="Secondary IPv4"/>
                                                </UniformGrid>
                                                <UniformGrid Columns="2">
                                                    <Button x:Name="BtnSaveCustomDns" Content="💾 Save Slot" Click="BtnSaveCustomDns_Click" Style="{StaticResource PillSoftBtnStyle}" Height="34" Margin="0,0,4,0"/>
                                                    <Button x:Name="BtnApplyCustomDns" Content="⚡ Apply Now" Click="BtnApplyCustomDns_Click" Style="{StaticResource PillPrimaryBtnStyle}" Height="34" Margin="4,0,0,0"/>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- ==================== VIEW 3: BOOST & NETWORK FIX ==================== -->
                            <ScrollViewer x:Name="ViewBoost" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                                <StackPanel Margin="0,6,0,8">
                                    <TextBlock x:Name="LblBoostTitle" Text="Boost &amp; Repair" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock x:Name="LblBoostSubtitle" Text="Simple one-tap tools — safe and reversible" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,12"/>

                                    <!-- Card 1: Game Mode Toggle -->
                                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,9" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="#24F43F5E" Margin="0,0,12,0">
                                                <TextBlock Text="🎮" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock x:Name="LblGameModeTitle" Text="Game Mode" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock x:Name="LblGameModeDesc" Text="Pauses background Windows clutter while gaming" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" x:Name="ToggleGameMode" Click="ToggleGameMode_Click" Style="{StaticResource ModernToggleSwitchStyle}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Card 2: Ad & Tracker Shield Toggle -->
                                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,9" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="#2410B981" Margin="0,0,12,0">
                                                <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock x:Name="LblAdShieldTitle" Text="Ad &amp; Tracker Shield" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock x:Name="LblAdShieldDesc" Text="Blocks ads &amp; trackers across all apps" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" x:Name="ToggleAdShield" Click="ToggleAdShield_Click" Style="{StaticResource ModernToggleSwitchStyle}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Card 2.5: Native Windows 11 DoH Encryption Toggle -->
                                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,9" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="#2467E8F9" Margin="0,0,12,0">
                                                <TextBlock Text="🔒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock x:Name="LblNativeDohTitle" Text="Encrypted DNS (Win11 DoH)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock x:Name="LblNativeDohDesc" Text="Uses native Windows 11 DNS-over-HTTPS on supported servers" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" x:Name="ToggleNativeDoh" Click="ToggleNativeDoh_Click" Style="{StaticResource ModernToggleSwitchStyle}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Card 3: Quick Network Fix -->
                                    <Button x:Name="BtnQuickFix" Click="BtnQuickFix_Click" Style="{StaticResource CardButtonStyle}" Margin="0,0,0,9" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="#2438BDF8" Margin="0,0,12,0">
                                                <TextBlock Text="✨" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="LblQuickFixTitle" Text="Quick Network Fix" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock x:Name="LblQuickFixDesc" Text="Clears DNS cache &amp; refreshes connection" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" x:Name="TxtQuickFixBadge" Text="Run" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <!-- Card 4: Full Network Fix (Full Adapter Reset) -->
                                    <Button x:Name="BtnFullFix" Click="BtnFullFix_Click" Style="{StaticResource CardButtonStyle}" Margin="0,0,0,9" Padding="14,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="#24FB923C" Margin="0,0,12,0">
                                                    <TextBlock Text="🔧" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock x:Name="LblFullFixTitle" Text="Full Network Fix" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock x:Name="LblFullFixDesc" Text="Restarts this adapter, flushes ARP/DNS &amp; renews DHCP IP" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" x:Name="TxtFullFixBadge" Text="Reset" FontSize="11.5" FontWeight="Bold" Foreground="#FB923C" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ProgressBar x:Name="FullFixProgress" Height="3" IsIndeterminate="True"
                                                         Foreground="#FB923C" Background="Transparent" BorderThickness="0"
                                                         Visibility="Collapsed" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Card 5: Quick Speed Check -->
                                    <Button x:Name="BtnQuickSpeed" Click="BtnQuickSpeed_Click" Style="{StaticResource CardButtonStyle}" Margin="0,0,0,9" Padding="14,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="#24F59E0B" Margin="0,0,12,0">
                                                    <TextBlock Text="🚀" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="LblSpeedCheckTitle" Text="Speed Check" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock x:Name="TxtSpeedCheckResult" Text="Tap to measure download speed" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" x:Name="TxtSpeedCheckBadge" Text="Start" FontSize="11.5" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ProgressBar x:Name="SpeedCheckProgress" Height="3" IsIndeterminate="True"
                                                         Foreground="#F59E0B" Background="Transparent" BorderThickness="0"
                                                         Visibility="Collapsed" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Card 6: Packet Loss & Jitter Stability Check -->
                                    <Button x:Name="BtnStabilityCheck" Click="BtnStabilityCheck_Click" Style="{StaticResource CardButtonStyle}" Padding="14,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="#24B57BFF" Margin="0,0,12,0">
                                                    <TextBlock Text="📶" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock x:Name="LblStabilityTitle" Text="Stability &amp; Packet Loss" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock x:Name="TxtStabilityResult" Text="Test Modem vs Internet loss &amp; jitter (~4s)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" x:Name="TxtStabilityBadge" Text="Test" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ProgressBar x:Name="StabilityCheckProgress" Height="3" IsIndeterminate="True"
                                                         Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0"
                                                         Visibility="Collapsed" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ==================== VIEW 4: UTILITIES (HOSTS & QUICK TOOLS) ==================== -->
                            <ScrollViewer x:Name="ViewUtilities" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                                <StackPanel Margin="0,6,0,8">
                                    <TextBlock x:Name="LblUtilTitle" Text="Utilities &amp; Hosts" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock x:Name="LblUtilSubtitle" Text="Windows hosts, blocklists &amp; handy tools" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,14"/>

                                    <!-- Card 1: Windows Hosts Manager -->
                                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,12" Padding="15,14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock x:Name="LblHostsCardTitle" Text="Windows Hosts Manager" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock x:Name="TxtHostsInstalledLists" Text="Clean default hosts" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="9,3.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtHostsRuleCount" Text="0 rules" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                            </Grid>

                                            <ComboBox x:Name="ComboHostsBlocklist" Style="{StaticResource ModernComboStyle}" FlowDirection="LeftToRight" Margin="0,0,0,10"/>

                                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                                <Button x:Name="BtnHostsApplyList" Content="➕ Apply List" Click="BtnHostsApplyList_Click" Style="{StaticResource PillPrimaryBtnStyle}" Height="36" FontSize="12" Margin="0,0,5,0"/>
                                                <Button x:Name="BtnHostsRemoveList" Content="➖ Remove" Click="BtnHostsRemoveList_Click" Style="{StaticResource PillSoftBtnStyle}" Height="36" FontSize="12" Margin="5,0,0,0"/>
                                            </UniformGrid>

                                            <ProgressBar x:Name="HostsProgress" Height="3" IsIndeterminate="True"
                                                         Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0"
                                                         Visibility="Collapsed" Margin="0,0,0,10"/>

                                            <UniformGrid Columns="2">
                                                <Button x:Name="BtnHostsBackup" Content="💾 Backup" Click="BtnHostsBackup_Click" Style="{StaticResource PillSoftBtnStyle}" Height="34" FontSize="11.5" Margin="0,0,5,7"/>
                                                <Button x:Name="BtnHostsRestore" Content="↺ Restore" Click="BtnHostsRestore_Click" Style="{StaticResource PillSoftBtnStyle}" Height="34" FontSize="11.5" Margin="5,0,0,7"/>
                                                <Button x:Name="BtnHostsNotepad" Content="📝 Notepad" Click="BtnHostsNotepad_Click" Style="{StaticResource PillSoftBtnStyle}" Height="34" FontSize="11.5" Margin="0,0,5,0"/>
                                                <Button x:Name="BtnHostsReset" Content="🧹 Default" Click="BtnHostsReset_Click" Style="{StaticResource PillSoftBtnStyle}" Height="34" FontSize="11.5" Margin="5,0,0,0"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 2: Compact Quick System Tools -->
                                    <Border Style="{StaticResource GlassCardStyle}" Padding="15,14">
                                        <StackPanel>
                                            <TextBlock x:Name="LblExtraToolsTitle" Text="Quick System Tools" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" x:Name="BtnPublicIpCheck" Click="BtnPublicIpCheck_Click" Style="{StaticResource PillSoftBtnStyle}" Height="38" HorizontalContentAlignment="Left" Padding="12,0">
                                                    <TextBlock x:Name="TxtPublicIpLabel" Text="🌍  Check My Public IP" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </Button>
                                                <Button Grid.Column="1" x:Name="BtnCopyPublicIp" Content="📋" Click="BtnCopyPublicIp_Click" Style="{StaticResource PillSoftBtnStyle}" Width="38" Height="38" Padding="0" Margin="6,0,0,0" Visibility="Collapsed" ToolTip="Copy Public IP"/>
                                            </Grid>

                                            <Button x:Name="BtnCleanTemp" Click="BtnCleanTemp_Click" Style="{StaticResource PillSoftBtnStyle}" Height="38" HorizontalContentAlignment="Left" Padding="12,0">
                                                <TextBlock x:Name="TxtCleanTempLabel" Text="🧹  Clean Old Temp Files (&gt;24h)" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ==================== VIEW 5: SETTINGS ==================== -->
                            <ScrollViewer x:Name="ViewSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                                <StackPanel Margin="0,6,0,8">
                                    <TextBlock x:Name="LblSettingsTitle" Text="Settings" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock x:Name="LblSettingsSubtitle" Text="Customize look, behavior &amp; updates" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,12"/>

                                    <!-- Appearance Theme -->
                                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock x:Name="LblThemeSection" Text="Appearance Theme" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                                            <WrapPanel x:Name="ThemeDotsPanel" Orientation="Horizontal" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="TxtActiveThemeName" Text="Aion Lavender" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Language -->
                                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock x:Name="LblLangSection" Text="Language / زبان" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                                            <UniformGrid Columns="2">
                                                <Button x:Name="BtnLangEn" Content="English" Click="BtnLangEn_Click" Style="{StaticResource PillSoftBtnStyle}" Height="36" Margin="0,0,5,0"/>
                                                <Button x:Name="BtnLangFa" Content="فارسی" Click="BtnLangFa_Click" Style="{StaticResource PillSoftBtnStyle}" Height="36" Margin="5,0,0,0"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Startup & Tray Behavior -->
                                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock x:Name="LblBehaviorSection" Text="Startup &amp; System Tray" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>

                                            <Grid Margin="0,0,0,10">
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock x:Name="LblAutoStartTitle" Text="Start with Windows" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock x:Name="LblAutoStartDesc" Text="Launch quietly in Tray on logon" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}"/>
                                                </StackPanel>
                                                <CheckBox x:Name="ToggleAutoStart" Click="ToggleAutoStart_Click" Style="{StaticResource ModernToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock x:Name="LblAutoConnectTitle" Text="Auto-Connect on Startup" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock x:Name="LblAutoConnectDesc" Text="Automatically connect selected DNS on launch" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}"/>
                                                </StackPanel>
                                                <CheckBox x:Name="ToggleAutoConnect" Click="ToggleAutoConnect_Click" Style="{StaticResource ModernToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock x:Name="LblMinToTrayTitle" Text="Minimize to Tray on Close" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock x:Name="LblMinToTrayDesc" Text="Keep quick controls in taskbar corner" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}"/>
                                                </StackPanel>
                                                <CheckBox x:Name="ToggleMinToTray" Click="ToggleMinToTray_Click" Style="{StaticResource ModernToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock x:Name="LblHotkeyTitle" Text="Quick Hotkey (Ctrl + Alt + D)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock x:Name="LblHotkeyDesc" Text="Toggle DNS connect/disconnect anywhere" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}"/>
                                                </StackPanel>
                                                <CheckBox x:Name="ToggleGlobalHotkey" Click="ToggleGlobalHotkey_Click" Style="{StaticResource ModernToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Network Adapter -->
                                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock x:Name="LblAdapterSection" Text="Network Adapter" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                <Button Content="↻" Click="BtnRefreshAdapters_Click" Style="{StaticResource ChromeIconBtnStyle}" Width="26" Height="26" HorizontalAlignment="Right" ToolTip="Refresh Adapters"/>
                                            </Grid>
                                            <ComboBox x:Name="ComboAdapters" SelectionChanged="ComboAdapters_SelectionChanged" Style="{StaticResource ModernComboStyle}" FlowDirection="LeftToRight">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding HardwareDesc}">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- Updates & Safe Reset -->
                                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Button x:Name="BtnCheckUpdates" Content="🔄 Check for Updates" Click="BtnCheckUpdates_Click" Style="{StaticResource PillPrimaryBtnStyle}" Height="38" Margin="0,0,0,8"/>
                                            <Button x:Name="BtnResetAll" Content="↺ Restore Original DNS &amp; Defaults" Click="BtnResetAll_Click" Style="{StaticResource PillSoftBtnStyle}" Height="36"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="TxtAppFooterVersion" Text="AionToolLite v1.1.0  ·  Created by Yoqaizo"
                                               FontSize="10.5"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,4,0,4"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ==================== FLOATING TOAST PILL ==================== -->
                        <Border x:Name="ToastBanner"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1.2"
                                CornerRadius="16"
                                Padding="14,8"
                                Margin="8,4,8,0"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ToastSlide" Y="-16"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
                            </Border.Effect>
                            <TextBlock x:Name="TxtToastMessage" Text="" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- ==================== FLOATING 5-ICON MOBILE BOTTOM NAV BAR ==================== -->
                    <Border Grid.Row="2"
                            Margin="14,2,14,14"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="3,3">
                        <UniformGrid Columns="5">
                            <RadioButton x:Name="NavHome" Tag="Home" IsChecked="True" Checked="BottomNav_Checked" Style="{StaticResource BottomNavItemStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.9"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 3,10.5 L 12,3 L 21,10.5 M 5,9.5 L 5,20 L 19,20 L 19,9.5"/>
                                    <TextBlock x:Name="LblNavHome" Text="Home" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavDns" Tag="Dns" Checked="BottomNav_Checked" Style="{StaticResource BottomNavItemStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.9"
                                          Data="M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 2,12 L 22,12 M 12,2 C 15.2,6 15.2,18 12,22 C 8.8,18 8.8,6 12,2"/>
                                    <TextBlock x:Name="LblNavDns" Text="DNS" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavBoost" Tag="Boost" Checked="BottomNav_Checked" Style="{StaticResource BottomNavItemStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Width="15" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.9"
                                          StrokeLineJoin="Round"
                                          Data="M 13,2 L 4,14 L 11,14 L 10,22 L 20,10 L 13,10 Z"/>
                                    <TextBlock x:Name="LblNavBoost" Text="Boost" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavUtilities" Tag="Utilities" Checked="BottomNav_Checked" Style="{StaticResource BottomNavItemStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.9"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M 14.7,6.3 A 1,1 0 0 0 14.7,7.7 L 16.3,9.3 A 1,1 0 0 0 17.7,9.3 L 21.5,5.5 A 6,6 0 0 1 13.6,13.4 L 6.7,20.3 A 2.1,2.1 0 0 1 3.7,17.3 L 10.6,10.4 A 6,6 0 0 1 18.5,2.5 Z"/>
                                    <TextBlock x:Name="LblNavUtilities" Text="Tools" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavSettings" Tag="Settings" Checked="BottomNav_Checked" Style="{StaticResource BottomNavItemStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Grid HorizontalAlignment="Center" Width="22" Height="16">
                                        <Path Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.9"
                                              Data="M 12,8 A 4,4 0 1 0 12,16 A 4,4 0 1 0 12,8 Z M 12,2 L 12,4 M 12,20 L 12,22 M 4.9,4.9 L 6.3,6.3 M 17.7,17.7 L 19.1,19.1 M 2,12 L 4,12 M 20,12 L 22,12 M 4.9,19.1 L 6.3,17.7 M 17.7,6.3 L 19.1,4.9"/>
                                        <Ellipse x:Name="SettingsUpdateBadge" Width="7" Height="7" Fill="#10B981"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,0,0"
                                                 Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock x:Name="LblNavSettings" Text="Settings" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
